<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31): allowBackup="false" only stops cloud backup, so
     device-to-device transfer is excluded here too. flutter_secure_storage's
     ciphertext would otherwise arrive on the new phone without the Keystore
     key that decrypts it (FR-21 / NFR-5). The app keeps no other state worth
     migrating; the user simply logs in again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
