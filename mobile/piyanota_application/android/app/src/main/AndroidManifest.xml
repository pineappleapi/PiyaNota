<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Needed for API calls (Module 3) and runtime Google Fonts fetching until
         Plus Jakarta Sans is bundled as a static asset. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- PIYA-206 AC2: in-app camera capture, requested at first use. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- PIYA-206 AC3: only Android 12L and older need a storage permission
         for the gallery; from Android 13 the system photo picker grants
         access to the chosen photos without one. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- PIYA-211 (user decision 2026-10-22): an export keeps running when
         the user leaves the app, under a foreground service with an
         "Exporting <title>… n%" notification. Its type is mediaProcessing
         on Android 15+ (on-device audio decode/stretch/encode is what it is
         for) and dataSync on 10..14, where mediaProcessing does not exist.
         POST_NOTIFICATIONS is asked once on Android 13+, at the first export
         or "Convert in Background" (PIYA-218); if refused, the export or
         the conversion still runs, just without the notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING"/>
    <!-- Optional so devices without a camera can still use gallery and PDF. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <application
        android:label="piyanota_application"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- PIYA-211: holds the foreground while an export runs; the work
             itself is ExportWorker's. Not exported: only this app starts it. -->
        <service
            android:name=".export.ExportJobService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing"/>
        <!-- PIYA-218: keeps the app (and its Dart poll) alive while a
             conversion is followed in the background, with a "Converting
             <title>..." notification. dataSync: it only follows the job's
             state on the server. Not exported: only this app starts it. -->
        <service
            android:name=".scan.ScanTrackingService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- PIYA-211: whether a file manager can open the folder an export
             was saved to, for the "Saved..." notification's tap. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="vnd.android.document/directory"/>
        </intent>
    </queries>
</manifest>
