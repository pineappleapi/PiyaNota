# Copy to backend/.env (gitignored) and fill in real values. These are placeholders.
# The app reads os.environ only; load this file with your process manager or shell.
PIYA_ENV=dev
PIYA_DATABASE_URL=postgresql://piya:change-me@localhost:5432/piya_dev
# DATABASE_URL is accepted as a fallback when PIYA_DATABASE_URL is unset.
PIYA_REQUIRE_HTTPS=false
PIYA_RESET_CODE_HMAC_KEY=change-me
PIYA_LOG_HASH_KEY=change-me
PIYA_ARGON2_TIME_COST=2
PIYA_ARGON2_MEMORY_KIB=19456
PIYA_SESSION_TTL_DAYS=30
PIYA_RESET_CODE_TTL_MINUTES=30
PIYA_STORAGE_BACKEND=memory
PIYA_B2_ENDPOINT=https://s3.example.invalid
PIYA_B2_BUCKET=change-me
PIYA_B2_KEY_ID=change-me
PIYA_B2_APP_KEY=change-me
PIYA_SIGNED_URL_TTL_SECONDS=3600
PIYA_MEDIA_URL_TTL_SECONDS=21600
PIYA_MAIL_BACKEND=memory
PIYA_BREVO_API_KEY=change-me
PIYA_MAIL_FROM=noreply@example.invalid
PIYA_MAIL_FROM_NAME=PiyaNota
PIYA_TRUSTED_PROXY_COUNT=1
PIYA_MAX_CONTENT_LENGTH=104857600
PIYA_MAX_IMAGE_BYTES=10485760
PIYA_MAX_PDF_BYTES=52428800
PIYA_MAX_IMAGE_PIXELS=50000000
PIYA_STANDARD_MAX_SIDE_PX=3000
PIYA_PDF_RENDER_DPI=200
PIYA_SUBMIT_LIMIT_PER_HOUR=10
PIYA_STATUS_READS_PER_MINUTE=120
PIYA_LIST_READS_PER_MINUTE=30
PIYA_LOGIN_IP_LIMIT=30
PIYA_LOGIN_IP_WINDOW_S=900
PIYA_SIGNUP_IP_LIMIT=10
PIYA_SIGNUP_IP_WINDOW_S=3600
PIYA_RESET_REQUEST_EMAIL_PER_HOUR=5
PIYA_RESET_REQUEST_IP_PER_HOUR=20
PIYA_RESET_CODE_IP_PER_HOUR=30
PIYA_CHANGE_PASSWORD_LIMIT=5
PIYA_CHANGE_PASSWORD_WINDOW_S=900
PIYA_QUEUE_CAPACITY=50
PIYA_RUN_BACKGROUND=false
PIYA_BACKGROUND_INTERVAL_S=600
PIYA_DB_POOL_MAX_SIZE=6
# Leave unset unless a pooled (PgBouncer transaction-mode) URL is used.
# PIYA_DB_PREPARE_THRESHOLD=
