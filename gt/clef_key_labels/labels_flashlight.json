   "clef": "clef at staff start: G | G8vb (treble with a small 8 below) | F | OTHER",
   "clef_desc": "description when clef == OTHER, else null",
   "key_signature": "signed count at staff start: +N sharps, -N flats, 0 none",
   "time_signature": "time signature printed at staff start (e.g. \"3/4\"), else null (not printed)",
   "mid_staff_changes": "list of {kind: clef|key|time, new_value (int for key, str for clef/time), bar_in_system (1-based bar of this system where the new sign takes effect), x_frac (approx. horizontal position 0-1 across the staff), note}",
   "staff_lines": "number of staff lines (5 for every staff here; a non-5-line staff would get voice=other)",
   "bbox": "[x0, y0, x1, y1], staff extent plus margin. For curled pages this is the envelope of the bowed staff and can include parts of neighbouring lyrics/notes.",
   "bbox_source": "staffline_detector+margin (classical staffline finder, +20 px x / +25 px y) | manual (read from gridded previews, approx. +-30 px)",
   "confidence": "sure | unsure (for the clef/key/time/change labels, not the bbox)",
   "note": "free text: handwriting, curl, duplicates, reasons for unsure"
  }
